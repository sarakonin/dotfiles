    emacs
    nala
    tmux
    neovim
    kitty
    fzf
    ssh
    zsh
    nmap
    net-tools
    netcat-openbsd
    ksshaskpass
	wl-clipboard
    zeal
    bat
    mc
    geany
    geany-plugins
    stow
    dnsutils
    hstr
    lnav
    ncdu
    flatpak
    zoxide
    eza
    gping
    bfs
    delta
    tldr-py
    irssi
    weechat
    wireshark
    swi-prolog
    clojure
    rlwrap
    mpich
    mpich-doc
    texlive-full
    default-jdk
    qbittorrent
    qemu-kvm
    libvirt-clients
    libvirt-daemon-system
    bridge-utils
    virtinst
    libvirt-daemon
    virt-manager
    cpu-checker
    hwloc
    libguestfs-tools
    virt-top
    qemu-guest-agent
